# Copiar a config/.env y completar. No incluir .env en la entrega.
# SQL Server: ODBC Driver 18 y unixODBC instalados; usuario de sólo lectura.
SQLSERVER_ODBC=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost,1433;DATABASE=Northwind;UID=usuario;PWD=CAMBIAR;Encrypt=yes;TrustServerCertificate=no
# Oracle: configurar el DSN HR_ODBC con Instant Client ODBC y el servicio correcto.
ORACLE_ODBC=DSN=HR_ODBC;UID=hr;PWD=CAMBIAR
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=bigdata_final
